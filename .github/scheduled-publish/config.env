# Settings for the scheduled publish of one pull request. Edit these to publish a different post.
# PR to merge, and the label that arms it. Remove the label from the PR to cancel the schedule.
PR_NUMBER=20
ARM_LABEL=scheduled-publish
# The post goes out only once this page is live (the monorepo post). Empty = no check.
REQUIRE_LIVE_URL=https://dlockamy.com/posts/2026/11/05/testing-the-monorepo-argument/
# The post's date is set to today's date in this time zone when it goes out.
PUBLISH_TZ=America/New_York
